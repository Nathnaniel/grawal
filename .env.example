# The site's public address, used for link preview images. Defaults to localhost.
NEXT_PUBLIC_SITE_URL=https://grawal.example.com

# Supabase project address and publishable key. Both are safe in the browser:
# row-level security is what protects each person's entries.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
